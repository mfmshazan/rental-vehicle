generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("RENTAL_DATABASE_URL")
}

enum Role {
  CUSTOMER
  OWNER
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String?
  role         Role      @default(OWNER)
  vehicles     Vehicle[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Vehicle {
  id           String    @id @default(cuid())
  ownerId      String
  owner        User      @relation(fields: [ownerId], references: [id])
  title        String
  brand        String
  model        String
  year         Int
  category     String
  city         String
  dailyRate    Int
  transmission String
  fuel         String
  seats        Int
  description  String
  features     String
  image        String
  photos       String    @default("[]")
  driveType    String    @default("Self-drive")
  active       Boolean   @default(true)
  demo         Boolean   @default(false)
  inquiries    Inquiry[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([active, city, category])
  @@index([ownerId])
}

model Inquiry {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String
  startDate String
  endDate   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([vehicleId, createdAt])
}
