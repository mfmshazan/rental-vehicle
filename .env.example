# Copy this file to .env and fill in real values.

# --- Database (PostgreSQL) ---
# Local Docker:  postgresql://postgres:postgres@localhost:5432/roam?schema=public
# Neon: paste the pooled connection string into DATABASE_URL and the direct
# (non-pooled) one into DIRECT_URL. On Vercel the Neon integration sets both.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/roam?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/roam?schema=public"

# Separate database used by the Playwright suite (prisma migrate reset wipes it).
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/roam_test?schema=public"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=""

NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Photo storage (Vercel Blob) ---
# Created automatically when you add a Blob store to the Vercel project. For
# local uploads, run `vercel env pull` or paste the token from the dashboard.
BLOB_READ_WRITE_TOKEN=""

# --- Email (Resend) ---
# Leave RESEND_API_KEY blank to log emails to the server console instead.
# Create a key at resend.com; EMAIL_FROM must use a domain you've verified
# (the onboarding@resend.dev sender only delivers to your own account email).
RESEND_API_KEY=""
EMAIL_FROM="Roam <onboarding@resend.dev>"
